{
  "name": "codex-usage-panel",
  "version": "0.3.3",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:native": "node scripts/build-native.mjs",
    "release:build": "node scripts/build-release.mjs",
    "start": "node scripts/build.mjs && node src/server.ts",
    "stop": "node scripts/stop.mjs",
    "demo": "node scripts/build.mjs && node src/server.ts --demo",
    "probe": "node scripts/probe.ts",
    "test": "node --test tests/*.test.ts",
    "security:check": "node scripts/check-secrets.mjs"
  }
}
